# Required for live analysis: none. PR Passport works unauthenticated
# against public repositories (60 requests/hour). Set a token to raise it.
# Scope: public repos read-only is enough. Never commit real tokens.
GITHUB_TOKEN=

# Optional: OpenAI-compatible inference endpoint used to interpret
# free-form contribution guidelines. Any open-weight model hosted behind
# an OpenAI-compatible /chat/completions API works.
# Examples of base URLs (the API root, without /chat/completions):
#   https://openrouter.ai/api/v1
#   https://api.together.xyz/v1
#   http://localhost:11434/v1        (Ollama)
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
INFERENCE_MODEL=
INFERENCE_TIMEOUT_MS=45000
# Set to "off" if your endpoint rejects response_format: {"type":"json_object"}
INFERENCE_JSON_MODE=on

# Set to "on" to make every analysis use the bundled demo fixtures.
DEMO_MODE=off